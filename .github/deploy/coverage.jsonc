{
  "$schema": "https://www.unpkg.com/wrangler/config-schema.json",
  // The tests' coverage report (`just combine-coverage` writes it to htmlcov/, the Test workflow
  // publishes it), served as static assets: no Worker script runs
  "name": "manimgx-coverage",
  "compatibility_date": "2026-09-25",
  "assets": { "directory": "../../htmlcov" },
  // Academa's internal/manimgx-hosting Terraform unit owns the domain and Worker identity.
  "workers_dev": false,
  // each commit's report is a deployment in the preview "main" or "pr-<number>", at
  // <preview>-manimgx-coverage.<account subdomain>.workers.dev; Cloudflare retains their
  // deployment history within the account plan's preview limits
  "preview_urls": true,
  "previews": {}
}
