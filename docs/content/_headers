# Response headers of the docs site, read by Cloudflare (never served):
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The theme's bundles are named after their content
/assets/javascripts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/stylesheets/*
  Cache-Control: public, max-age=31536000, immutable

# workers.dev hosts (previews, and the site until it has its domain) stay out of search results
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
